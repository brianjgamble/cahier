cabal-version: 3.14
name: cahier
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE-code.md
maintainer: brianjgamble@users.noreply.github.com
author: Brian Gamble
category: Web
build-type: Simple
extra-doc-files: CHANGELOG.md

-- enable Haskell language features
common common-extensions
  default-extensions:
    BlockArguments
    OverloadedStrings
    QuasiQuotes

library lib-web
  import: common-extensions
  hs-source-dirs: src/web
  exposed-modules:
    Templates.About
    Templates.Articles
    Templates.Blog
    Templates.Contact
    Templates.Home
    Templates.Layout

  build-depends:
    base >=4.21 && <5,
    blaze-html >=0.9.2 && <0.10,
    shakespeare >=2.1.7 && <2.2,
    text >=2.1.2 && <2.2,

  default-language: GHC2024

executable cahier
  import: common-extensions
  main-is: Main.hs
  hs-source-dirs: app
  other-modules:
    Config

  default-language: GHC2024
  ghc-options: -Wall
  build-depends:
    base >=4.21 && <5,
    blaze-html >=0.9.2 && <0.10,
    cahier:lib-web,
    scotty >=0.22 && <0.23,
    string-interpolate >=0.3.4 && <0.4,
    wai-extra >=3.1.18 && <3.2,
    wai-middleware-static >=0.9.3 && <0.10,
    warp >=3.4.9 && <3.5,
