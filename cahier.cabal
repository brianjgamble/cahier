cabal-version: 3.14
name: cahier
version: 0.3.1
license: BSD-3-Clause
license-file: LICENSE-code.md
maintainer: brianjgamble@users.noreply.github.com
author: Brian Gamble
category: Web
build-type: Simple
extra-doc-files: CHANGELOG.md

executable cahier
  main-is: Main.hs
  hs-source-dirs: app
  other-modules:
    Config

  build-depends:
    base >=4.21 && <5,
    blaze-html >=0.9.2 && <0.10,
    cahier-content,
    lib-web,
    scotty >=0.22 && <0.31,
    string-interpolate >=0.3.4 && <0.4,
    text >=2.1.2 && <2.2,
    wai-extra >=3.1.18 && <3.2,
    wai-middleware-static >=0.9.3 && <0.10,
    warp >=3.4.9 && <3.5,

  default-extensions:
    BlockArguments
    MultilineStrings
    OverloadedStrings
    QuasiQuotes

  default-language: GHC2024
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
