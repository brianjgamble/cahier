cabal-version: 3.14
name: lib-core
version: 0.1.0.0
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
    Cahier.Core.Greetings

  build-depends:
    base >=4.21 && <5

  default-language: GHC2024

test-suite core-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
    base >=4.21 && <5,
    lib-core,
    tasty >=1.4 && <2,
    tasty-hunit >=0.10 && <0.11
  default-language:  GHC2024
