cabal-version: 3.14
name: lib-core
version: 0.1.0.0
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
    Cahier.Core.Content
    Cahier.Core.Content.Cache
    Cahier.Core.Content.Files
    Cahier.Core.Content.Parse
    Cahier.Core.Content.Types
    Cahier.Core.Content.Util

  build-depends:
    aeson >=2.2.3 && <2.3,
    base >=4.21 && <5,
    commonmark >=0.2.6 && <0.3,
    commonmark-extensions >=0.2.6 && <0.3,
    containers >=0.7 && <0.8,
    directory >=1.3.9 && <1.4,
    filepath >=1.5.4 && <1.6,
    text >=2.1.2 && <2.2,
    time >=1.14 && <1.15,
    yaml >=0.11.11 && <0.12,

  default-extensions:
    DeriveGeneric
    OverloadedStrings

  default-language: GHC2024

test-suite core-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules:
    Core.Content.UtilTest

  build-depends:
    base >=4.21 && <5,
    lib-core,
    tasty >=1.4 && <2,
    tasty-hunit >=0.10 && <0.11,
    text >=2.1.2 && <2.2,

  default-extensions:
    OverloadedStrings

  default-language: GHC2024

test-suite core-doctest
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Doctest.hs
  default-extensions: OverloadedStrings
  build-depends:
    base >=4.14 && <5,
    doctest >=0.22,

  default-language: GHC2024
