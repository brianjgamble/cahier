cabal-version: 3.14
name: lib-web
version: 0.1.0.0
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
    Cahier.Web.Templates.About
    Cahier.Web.Templates.Articles
    Cahier.Web.Templates.Blog
    Cahier.Web.Templates.Contact
    Cahier.Web.Templates.Home
    Cahier.Web.Templates.Layout

  build-depends:
    base >=4.21 && <5,
    blaze-html >=0.9.2 && <0.10,
    shakespeare >=2.1.7 && <2.2,
    text >=2.1.2 && <2.2,

  default-extensions:
    OverloadedStrings
    QuasiQuotes

  default-language: GHC2024

test-suite web-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
    base >=4.14 && <5,
    lib-web,
    tasty >=1.4 && <2,
    tasty-hunit >=0.10 && <0.11,
  default-language:  GHC2024
